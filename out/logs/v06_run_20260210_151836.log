import torch
import torch.nn as nn
from preprocess import get_data, cnt_total, get_batches_shuffle
from DisaModel import DisaModel
import torchinfo
import torch.optim as optim
import numpy as np
import time
import sys


def eval(data_folder, model_path):
    """
    Evaluate model performance on test dataset

    Args:
        data_folder: Path to the dataset directory
        model_path: Path to the trained model

    """
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = DisaModel(embed_size=d_model, vocab_size=vocab_size, ins_seq_len=seq_len, dropout=dropout_rate,
                      num_heads=num_heads, num_layers=num_layers).to(device)
    map_location = torch.device('cpu') if not torch.cuda.is_available() else None
    model.load_state_dict(torch.load(model_path, map_location=map_location))
    model.eval()

    all_data, all_label, all_addr = get_data(data_folder)

    fn_addr = []
    fp_addr = []

    cnt_total(all_label)
    total = all_data.shape[0]
    with torch.no_grad():
        # Confusion matrix
        cm = np.zeros((2, 2), dtype=np.long)
        # correct = 0
        for data, label in get_batches_shuffle(all_data, all_label, batch_size, max_len=seq_len, shuffle=False):
            data = torch.LongTensor(data).to(device)
            label = torch.LongTensor(label).to(device)
            label = label.view(-1)
            addr = all_addr[:len(label)]
            del all_addr[:len(label)]

            pred = model(data)  # [batch_size * seq_len, 2] Model prediction results
            _, pred_result = torch.max(pred.data, dim=1)
            # print('predict: ', pred_result[:20])
            # print('label: ', label[:20])
            # correct += (pred_result == label).sum().item()
            for predict, y, add in zip(pred_result.cpu().numpy(), label.cpu().numpy(), addr):
                if y == 0 or y == 1:
                    cm[predict, y] += 1
                    if (predict == 1 and y == 0):
                        fp_addr.append(add)
                    if (predict == 0 and y == 1):
                        fn_addr.append(add)
        print(cm)
        precision = cm[1, 1].item() / ((cm[1, 0] + cm[1, 1]).item() + 0.000000000000000001)
        recall = cm[1, 1].item() / ((cm[0, 1] + cm[1, 1]).item())
        f1 = 2 * (precision * recall) / (precision + recall + 0.000000000000000000001)
        print('total: ', total)
        print('precision: ', precision)
        print('recall: ', recall)
        print('f1-score: ', f1)



if __name__ == '__main__':
    # Model hyperparameters
    d_model = 384  # Current metadata [Opcode, modRM, SIB] instruction feature dimension
    vocab_size = 2308  # Vocabulary size
    seq_len = 512  # Instruction sequence length
    dropout_rate = 0.1
    num_heads = 8
    num_layers = 6

    # Training hyperparameters
    batch_size = 16  # 16
    lr = 0.0001
    epochs = 10
    accumulation_steps = 1  # Simulate large batch_size effect, actual batch_size is batch_size * accumulation_steps

    model_path = sys.argv[1]

    eval_binaries = sys.argv[2]

    eval_start = time.time()
    eval(eval_binaries, model_path)
    eval_end = time.time()
    print('Evaluation time: ', eval_end - eval_start)
